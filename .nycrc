{
    "cache": true,
    "check-coverage": true,
    "lines": 95,
    "statements": 95,
    "functions": 95,
    "branches": 90,
    "include": ["dist/server/**/*.js"],
    "reporter": ["lcov", "text-summary"],
    "report-dir": "coverage",
    "temp-directory": "coverage/.nyc_output",
    "watermarks": {
        "lines": [75, 90],
        "statements": [75, 90],
        "functions": [75, 90],
        "branches": [75, 90]
    }
}
